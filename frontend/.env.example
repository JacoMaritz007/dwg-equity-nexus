# Copy to .env for local development.
#
# Firebase/Identity Platform Web API key is meant to be public (embedded in
# the client bundle) — it identifies the project, it doesn't authorize
# anything by itself. Actual authorization happens server-side, both in
# Identity Platform's own token verification and in the backend API's
# authz layer. Get the current value with:
#   curl -sS "https://identitytoolkit.googleapis.com/admin/v2/projects/equity-nexus/config" \
#     -H "Authorization: Bearer $(gcloud auth print-access-token)" \
#     -H "x-goog-user-project: equity-nexus" | grep apiKey

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=equity-nexus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=equity-nexus

VITE_API_BASE_URL=http://localhost:8080
