# Copy to .env for local development. In Cloud Run, these are set as
# service env vars / Secret Manager references at deploy time instead.

GCP_PROJECT_ID=equity-nexus
INSTANCE_CONNECTION_NAME=equity-nexus:africa-south1:equity-nexus-db
DB_USER=app_user
DB_NAME=equity_nexus
# Fetch locally with:
#   gcloud secrets versions access latest --secret=db-app-user-password --project=equity-nexus
DB_PASSWORD=

PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
